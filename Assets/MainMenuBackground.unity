--- !u!114 &3570
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 647}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cd97fa44407f59992f17262f31dbf9a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_TextID: 99023
  m_Text: 'Date of birth: September 23rd, 2310'
  m_TextDyn: "Manufacturing date: February 1st, 2331\n\n(Sentient Android Registered
    Assistant)\nwas the first  model containing Althar\nInc.\u2019s fifth-generation
    \u201CGenesis chip\u201D.\nS.A.R.A. demonstrated unusual\n\u201Cpatience\u201D
    (if such a   concept can be\napplied to sentient androids). She was\ndecommissioned
    from Federation status\nin 2335, and entered the private sector.\nJohn Slade purchased
    her services soon\nthereafter."
  m_Font: {fileID: 3998}
  m_AnchorPoint: 0
  m_Alignment: 0
  m_LineSpace2: 0
  m_UseFontExGen: 0
