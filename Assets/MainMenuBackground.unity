--- !u!114 &3525
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 622}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cd97fa44407f59992f17262f31dbf9a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_TextID: 99025
  m_Text: 'Date of birth: September 23rd, 2310'
  m_TextDyn: "Decommissioned frigate-class spaceship\n\nHeavily modified for combat
    with\ndrop-bay room for two landing modules.\nThe Rook is capable of interstellar\njumps,
    requiring a large amount of\nliquefied Palladium.\nSpecs: Medium range cannons
    (2)\nspace-to-surface \u201CHellwind\u201D missiles (6)\nshort range flak guns
    (4)\nlong range laser bolt, \u201CThunder\u201D class (1)"
  m_Font: {fileID: 3998}
  m_AnchorPoint: 0
  m_Alignment: 0
  m_LineSpace2: 0
  m_UseFontExGen: 0
