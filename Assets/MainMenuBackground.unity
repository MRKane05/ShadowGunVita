  m_Name: 
  m_EditorClassIdentifier: 
  m_TextID: 98029
  m_Text: 'Date of birth: September 23rd, 2310'
  m_TextDyn: 'Type: PRIVATE SPEC OPS.

    Reinforced Advanced Tactical

    Scientists.This special division of

    Toltech Corporation is used everytime

    there is a need for both combat

    and scientific support. Highly trained

    in bio-research and squad-based

    tactics.'
  m_Font: {fileID: 3998}
  m_AnchorPoint: 0
  m_Alignment: 0
  m_LineSpace2: 0
  m_UseFontExGen: 0
