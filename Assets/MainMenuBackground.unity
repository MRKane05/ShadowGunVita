--- !u!114 &3573
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cd97fa44407f59992f17262f31dbf9a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_TextID: 99021
  m_Text: 'Date of birth: September 23rd, 2310'
  m_TextDyn: "Date of birth: September 23rd, 2310\n\nA former Federation Marine,\nJohn
    Slade retired due to injuries\nsustained in the attack on planet Nodd.\nIt is
    believed John became a Shadowgun\ncirca 2340, and his reputation quickly\nspread.
    His extensive combat\nexperience, tech prowess, and high\nintelligence have made
    John one\nof the galaxy\u2019s most prized Shadowguns"
  m_Font: {fileID: 3998}
  m_AnchorPoint: 0
  m_Alignment: 0
  m_LineSpace2: 0
  m_UseFontExGen: 0
