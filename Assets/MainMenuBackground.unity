  m_Name: 
  m_EditorClassIdentifier: 
  m_TextID: 98027
  m_Text: 'Date of birth: September 23rd, 2310'
  m_TextDyn: 'Type: PLASMA REACTOR

    High-power reactor based on Tri-Tank

    technology uses triple sub-cores

    to re-route powerful beams of

    plasma energy into each other,

    accumulating it for short periods

    and projecting into power mainframe.'
  m_Font: {fileID: 3998}
  m_AnchorPoint: 0
  m_Alignment: 0
  m_LineSpace2: 0
  m_UseFontExGen: 0
