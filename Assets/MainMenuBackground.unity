  m_Script: {fileID: 11500000, guid: cd97fa44407f59992f17262f31dbf9a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_TextID: 98025
  m_Text: 'Date of birth: September 23rd, 2310'
  m_TextDyn: 'Type: PERSONNEL CARRIER

    Standartized armored carrier used by

    many corporations for transporting

    both cargo & personnel.

    Thanks to the advanced materials,

    this class B ship is able to hold out

    extensive damage, but still achieving

    reasonable transporting speed.'
  m_Font: {fileID: 3998}
  m_AnchorPoint: 0
  m_Alignment: 0
  m_LineSpace2: 0
  m_UseFontExGen: 0
