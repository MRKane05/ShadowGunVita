  m_Script: {fileID: 11500000, guid: cd97fa44407f59992f17262f31dbf9a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_TextID: 99027
  m_Text: 'Date of birth: September 23rd, 2310'
  m_TextDyn: "Founded 2158, Headquartered: Corrine\nSystem Orbit Toltech Space Archipelago\nNotes:
    One of the galaxy\u2019s largest\nbiotech firms, with manufacturing and\nresearch
    labs spread out over several\nplanets and star systems. Toltech uses\nforce where
    diplomacy and bribery\ndo not work, often hiring mercs for\ncorporate espionage
    missions, primarily\nagainst their chief rival, Althar\nCorporation."
  m_Font: {fileID: 3998}
  m_AnchorPoint: 0
  m_Alignment: 0
  m_LineSpace2: 0
  m_UseFontExGen: 0
